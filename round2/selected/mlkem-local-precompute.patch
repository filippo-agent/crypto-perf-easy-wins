-	for i := range f {
-		f[i] = fieldMul(f[i], 3303) // 3303 = 128⁻¹ mod q
+	// The first six stages consume zetas[127] through zetas[2].
+	// Fuse the final stage (zeta = zetas[1]) with scaling by 128⁻¹.
+	const scale = 3303
