+package nistec
+
+// publicNAF recodes a public big-endian scalar in width-5 non-adjacent form.
+// Digits are zero or odd in [-15, 15], with at least four zero digits between
+// nonzero digits. One extra digit accommodates a carry past the input width.
+// The input is at most 66 bytes. This function is NOT constant time.
+func publicNAF(s []byte) (out [529]int8) {
+	if len(s) > 66 {
+		panic("nistec: public scalar too long")
+	}
+	bit := func(i int) int {
+		if i >= len(s)*8 {
+			return 0
+		}
+		return int(s[len(s)-1-i/8] >> uint(i%8) & 1)
+	}
+	carry := 0
+	for i := 0; i <= len(s)*8; {
+		low := bit(i) + carry
+		if low&1 == 0 {
+			carry = low >> 1
+			i++
+			continue
+		}
+		digit := carry
+		for j := 0; j < 5; j++ {
+			digit += bit(i+j) << uint(j)
+		}
+		carry = 0
+		if digit >= 16 {
+			digit -= 32
+			carry = 1
+		}
+		out[i] = int8(digit)
+		i += 5
+	}
+	return
+}
