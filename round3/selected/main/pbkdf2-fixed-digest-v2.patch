+++ b/src/crypto/internal/fips140/hmac/hmac.go
@@ -207,3 +207,24 @@ func New[H hash.Hash](h func() H, key []byte) *HMAC {
 func MarkAsUsedInKDF(h *HMAC) {
 	h.forHKDF = true
 }
+
+// PBKDF2InnerLoop executes the fixed-size digest recurrence for PBKDF2, if
+// supported. The HMAC's live digest state is not updated; the caller must Reset
+// before its next use. T and U must be separate complete-digest buffers.
+func PBKDF2InnerLoop(h *HMAC, T, U []byte, rounds int) bool {
+	inner, innerOK := h.inner.(*sha256.Digest)
+	outer, outerOK := h.outer.(*sha256.Digest)
+	if !h.forHKDF || !h.marshaled || !innerOK || !outerOK ||
+		inner.Size() != 32 || outer.Size() != 32 {
+		return false
+	}
+	// Decode existing checkpoints once per derived-key block, not each round.
+	i, o := *inner, *outer
+	if err := i.UnmarshalBinary(h.ipad); err != nil {
+		panic(err)
+	}
+	if err := o.UnmarshalBinary(h.opad); err != nil {
+		panic(err)
+	}
+	return sha256.PBKDF2InnerLoop(&i, &o, T, U, rounds)
+}
