+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package sha256
+
+import (
+	"crypto/internal/fips140"
+	"crypto/internal/fips140deps/byteorder"
+)
+
+// PBKDF2InnerLoop performs rounds iterations U = HMAC(U), accumulating U
+// into T. inner and outer must be SHA-256 checkpoints after one pad block.
+// T and U must be separate 32-byte buffers. This is only for package pbkdf2,
+// through package hmac. It deliberately does not support SHA-224.
+func PBKDF2InnerLoop(inner, outer *Digest, T, U []byte, rounds int) bool {
+	if inner.is224 || outer.is224 || inner.nx != 0 || outer.nx != 0 ||
+		inner.len != blockSize || outer.len != blockSize || len(T) != size || len(U) != size {
+		return false
+	}
+	var input [blockSize]byte
+	copy(input[:size], U)
+	input[size] = 0x80
+	// Each inner and outer hash covers the 64-byte key pad and 32-byte digest.
+	byteorder.BEPutUint64(input[56:], (blockSize+size)*8)
+	var total [8]uint32
+	for i := range total {
+		total[i] = byteorder.BEUint32(T[4*i:])
+	}
+	var d Digest
+	for r := 0; r < rounds; r++ {
+		d.h = inner.h
+		block(&d, input[:])
+		for i, word := range d.h {
+			byteorder.BEPutUint32(input[4*i:], word)
+		}
+		d.h = outer.h
+		block(&d, input[:])
+		for i, word := range d.h {
+			total[i] ^= word
+			byteorder.BEPutUint32(input[4*i:], word)
+		}
+	}
+	copy(U, input[:size])
+	for i, word := range total {
+		byteorder.BEPutUint32(T[4*i:], word)
+	}
+	fips140.RecordApproved()
+	return true
+}
