 		v.reset(OpAMD64FlagEQ)
 		return true
 	}
-	// match: (Select1 (NEGLflags (NEGQ (SBBQcarrymask x))))
+	// match: (Select1 (NEGLflags (MOVBQZX (SETB x))))
 	// result: x
